# Style List - every one of these is optional.
#
# With none of them set, the app still works end to end: photos are cleaned up
# on the device, items are identified from the pixels, and Settings says so
# plainly. Setting one swaps in a real service without any code change.

# Identify clothing from a photo with Claude.
# Turns on POST /api/ai/analyze.
ANTHROPIC_API_KEY=

# A service that takes multipart "image" and returns a cleaned-up image.
# Turns on POST /api/ai/process-image.
STYLE_LIST_IMAGE_API_URL=
STYLE_LIST_IMAGE_API_KEY=
STYLE_LIST_IMAGE_API_NAME=

# A service that takes a photo of the person plus the garment images and
# returns a rendering. Turns on Try It On.
STYLE_LIST_TRY_ON_API_URL=
STYLE_LIST_TRY_ON_API_KEY=
